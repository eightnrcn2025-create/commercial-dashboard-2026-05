<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eight.dashboard-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/laoba/commercial-dashboard/run.sh</string>
    </array>

    <!-- 每 1800 秒（30 分钟）跑一次。Mac 不在线就跳过，下次再试 -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/laoba/commercial-dashboard/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/laoba/commercial-dashboard/logs/stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/laoba/commercial-dashboard</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
